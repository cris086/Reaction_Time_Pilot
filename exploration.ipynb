   "source": [
    "import numpy as np\n",
    "resp_times = [312, 285, 410, 298, 355, 520]\n",
    "no_outliers = []\n",
    "for nr in resp_times:\n",
    "    if nr < 450:\n",
    "        no_outliers.append(nr)\n",
    "print(no_outliers)\n",
    "print(np.mean(no_outliers))"
   ]
  }
